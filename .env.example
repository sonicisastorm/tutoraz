FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-change-me-in-production

# LOCAL DEV: uses SQLite (no Postgres install needed)
# DATABASE_URL is intentionally blank here — app defaults to SQLite
# DATABASE_URL=sqlite:///tutoraz_dev.db

# PRODUCTION (Render sets this automatically from the database):
# DATABASE_URL=postgresql://user:password@host:5432/tutoraz
