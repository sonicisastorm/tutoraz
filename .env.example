FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-change-me-in-production

# LOCAL DEV: uses SQLite (no Postgres install needed)
# DATABASE_URL is intentionally blank here — app defaults to SQLite
# DATABASE_URL=sqlite:///tutoraz_dev.db

# PRODUCTION (Render sets this automatically from the database):
# DATABASE_URL=postgresql://user:password@host:5432/tutoraz

# ── Stripe (test mode) ──────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From https://dashboard.stripe.com/test/webhooks (only needed for webhook testing)
STRIPE_WEBHOOK_SECRET=whsec_...

# Your app's base URL — used to build Stripe redirect links
# Local: http://localhost:5000  |  Production: https://your-app.onrender.com
DOMAIN=http://localhost:5000
